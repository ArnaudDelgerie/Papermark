<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="{{ app_theme_mode().value }}">
    <head>
        <meta charset="UTF-8">
        <meta name="csrf-token" content="{{ csrf_token('papermark_app') }}">
        <title>{{ 'templates.base.title'|trans({}, 'templates') }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

    </head>
    <body>
        {% block body %}{% endblock %}
        {% set flash_messages = [] %}
        {% for type, messages in app.flashes() %}
            {% for message in messages %}
                {% set flash_messages = flash_messages|merge([{ type: type, message: message }]) %}
            {% endfor %}
        {% endfor %}
        {# The close label is the server's too (SET-05, lot 09): no hardcoded
           text in the front, not even for an aria-label. #}
        <div data-controller="toast"
             data-toast-messages-value="{{ flash_messages|json_encode }}"
             data-toast-close-label-value="{{ 'templates.base.close'|trans({}, 'templates') }}"
             class="toast-container" aria-live="polite"></div>
    </body>
</html>
