<!DOCTYPE html>
<html data-theme="{{ app_theme_mode().value }}">
    <head>
        <meta charset="UTF-8">
        <title>{{ 'templates.base.title'|trans({}, 'templates') }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

    </head>
    <body>
        {% block body %}{% endblock %}
        {% set flash_messages = [] %}
        {% for type, messages in app.flashes() %}
            {% for message in messages %}
                {% set flash_messages = flash_messages|merge([{ type: type, message: message }]) %}
            {% endfor %}
        {% endfor %}
        <div data-controller="toast" data-toast-messages-value="{{ flash_messages|json_encode }}" class="toast-container" aria-live="polite"></div>
        {# Loader markup kept in one place, translated server-side, so any
           controller can show it before a fetch (see utils/sidebar-loading.js). #}
        <template id="sidebar-loading">{% include 'components/_sidebar_loading.html.twig' %}</template>
    </body>
</html>
