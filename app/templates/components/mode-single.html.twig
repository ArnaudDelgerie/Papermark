<div class="editor-sidebar-panel" data-controller="mode-single"
     data-mode-single-editor-state-outlet="#editor-state"
     data-mode-single-i18n-value="{{ i18n|json_encode }}"{% if not active %} hidden{% endif %}>
    <button type="button" class="editor-sidebar-btn" data-mode-single-target="openButton" data-action="click->mode-single#openFile" data-editor-leave-guard>
        {{ 'components.editor.open'|trans({}, 'components') }}
    </button>
    {# Shown until the controller has read the history from sessionStorage. #}
    <div data-mode-single-target="loading">
        {% include 'components/_sidebar_loading.html.twig' %}
    </div>
    <ul class="mode-history" data-mode-single-target="list" hidden></ul>
    <p class="mode-history-empty" data-mode-single-target="empty" hidden>
        {{ 'components.mode.history.empty'|trans({}, 'components') }}
    </p>
</div>
