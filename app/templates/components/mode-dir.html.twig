<div class="editor-sidebar-panel mode-dir-panel" data-controller="mode-dir"
     data-mode-dir-editor-state-outlet="#editor-state"
     data-mode-dir-dir-value="{{ dir }}"
     data-mode-dir-i18n-value="{{ i18n|json_encode }}"{% if not active %} hidden{% endif %}>
    {{ component('current-directory') }}

    <div class="mode-dir-toolbar" data-mode-dir-target="toolbar"{% if not has_directory %} hidden{% endif %}>
        <button type="button" class="mode-dir-refresh" data-mode-dir-target="refreshButton"
                data-action="click->mode-dir#refresh"
                title="{{ 'components.mode.tree.refresh'|trans({}, 'components') }}">
            <span class="visually-hidden">{{ 'components.mode.tree.refresh'|trans({}, 'components') }}</span>
        </button>
    </div>

    <turbo-frame id="mode-dir-tree" src="{{ path('app_editor_get_dir') }}" refresh="morph"
                 data-mode-dir-target="treeFrame" data-action="turbo:before-morph-attribute->mode-dir#keepFolderState">
        {# UX-13, lot 10: what the frame shows until the tree's first answer. #}
        {% include 'components/_sidebar_loading.html.twig' %}
    </turbo-frame>
</div>
