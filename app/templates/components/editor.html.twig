<div data-controller="editor"
     class="editor is-a4"
     data-editor-file-csrf-token-value="{{ file_csrf_token }}"
     data-editor-ai-csrf-token-value="{{ ai_csrf_token }}"
     data-editor-ai-config-value="{{ ai_config|json_encode }}"
     {% if readonly %}data-editor-readonly-value="true"{% endif %}
     data-editor-i18n-value="{{ i18n|json_encode }}"
     style="height: {{ css_height }};">
    <div class="editor-file-bar">
        <button type="button" class="editor-filebar-btn" data-action="click->editor#openFile" data-editor-leave-guard>
            {{ 'components.editor.open'|trans({}, 'components') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="saveButton" data-action="click->editor#saveFile" disabled>
            {{ 'components.editor.save'|trans({}, 'components') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="saveAsButton" data-action="click->editor#saveFileAs" disabled>
            {{ 'components.editor.save_as'|trans({}, 'components') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="printButton" data-action="click->editor#printFile" disabled>
            {{ 'components.editor.print'|trans({}, 'components') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="copyMarkdownButton" data-action="click->editor#copyMarkdown" disabled>
            {{ 'components.editor.copy_markdown'|trans({}, 'components') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="a4Button" data-action="click->editor#toggleA4">
            {{ 'components.editor.full_width'|trans({}, 'components') }}
        </button>
        <span class="editor-dirty-indicator" data-editor-target="dirtyIndicator" hidden>
            {{ 'components.editor.unsaved.indicator'|trans({}, 'components') }}
        </span>
        <button type="button" class="editor-filebar-btn editor-toggle-btn" data-editor-target="toggleButton" data-action="click->editor#toggleReadonly">
            {{ readonly
                ? 'components.editor.toggle.edit'|trans({}, 'components')
                : 'components.editor.toggle.readonly'|trans({}, 'components') }}
        </button>
        <a href="{{ path('app_settings') }}" class="editor-filebar-btn editor-settings-btn" data-editor-leave-guard>
            {{ 'components.editor.settings'|trans({}, 'components') }}
        </a>
    </div>
</div>
