{% set height = height|default(400) %}
{% set readonly = readonly|default(false) %}
<div data-controller="editor"
     class="editor is-a4"
     data-editor-csrf-token-value="{{ csrf_token('upload') }}"
     data-editor-file-csrf-token-value="{{ csrf_token('file') }}"
     {% if readonly %}data-editor-readonly-value="true"{% endif %}
     data-editor-i18n-value="{{ {
    placeholder: 'templates.home.index.editor.placeholder'|trans({}, 'templates'),
    link: {
        confirm: 'templates.home.index.editor.link.confirm'|trans({}, 'templates'),
        inputPlaceholder: 'templates.home.index.editor.link.input_placeholder'|trans({}, 'templates'),
    },
    toggle: {
        edit: 'templates.home.index.editor.toggle.edit'|trans({}, 'templates'),
        readonly: 'templates.home.index.editor.toggle.readonly'|trans({}, 'templates'),
    },
    a4: 'templates.home.index.editor.a4'|trans({}, 'templates'),
    full_width: 'templates.home.index.editor.full_width'|trans({}, 'templates'),
    slashMenu: {
        text: 'templates.home.index.editor.slash_menu.text'|trans({}, 'templates'),
        paragraph: 'templates.home.index.editor.slash_menu.paragraph'|trans({}, 'templates'),
        h1: 'templates.home.index.editor.slash_menu.h1'|trans({}, 'templates'),
        h2: 'templates.home.index.editor.slash_menu.h2'|trans({}, 'templates'),
        h3: 'templates.home.index.editor.slash_menu.h3'|trans({}, 'templates'),
        h4: 'templates.home.index.editor.slash_menu.h4'|trans({}, 'templates'),
        h5: 'templates.home.index.editor.slash_menu.h5'|trans({}, 'templates'),
        h6: 'templates.home.index.editor.slash_menu.h6'|trans({}, 'templates'),
        quote: 'templates.home.index.editor.slash_menu.quote'|trans({}, 'templates'),
        divider: 'templates.home.index.editor.slash_menu.divider'|trans({}, 'templates'),
        list: 'templates.home.index.editor.slash_menu.list'|trans({}, 'templates'),
        bulletList: 'templates.home.index.editor.slash_menu.bullet_list'|trans({}, 'templates'),
        orderedList: 'templates.home.index.editor.slash_menu.ordered_list'|trans({}, 'templates'),
        taskList: 'templates.home.index.editor.slash_menu.task_list'|trans({}, 'templates'),
        advanced: 'templates.home.index.editor.slash_menu.advanced'|trans({}, 'templates'),
        image: 'templates.home.index.editor.slash_menu.image'|trans({}, 'templates'),
        code: 'templates.home.index.editor.slash_menu.code'|trans({}, 'templates'),
        table: 'templates.home.index.editor.slash_menu.table'|trans({}, 'templates'),
    },
}|json_encode }}" style="height: {% if height matches '/^\\d+$/' %}{{ height }}px{% else %}{{ height }}{% endif %};">
    <div class="editor-file-bar">
        <button type="button" class="editor-filebar-btn" data-action="click->editor#openFile">
            {{ 'templates.home.index.editor.open'|trans({}, 'templates') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="saveButton" data-action="click->editor#saveFile" disabled>
            {{ 'templates.home.index.editor.save'|trans({}, 'templates') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="saveAsButton" data-action="click->editor#saveFileAs" disabled>
            {{ 'templates.home.index.editor.save_as'|trans({}, 'templates') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="printButton" data-action="click->editor#printFile" disabled>
            {{ 'templates.home.index.editor.print'|trans({}, 'templates') }}
        </button>
        <button type="button" class="editor-filebar-btn" data-editor-target="a4Button" data-action="click->editor#toggleA4">
            {{ 'templates.home.index.editor.full_width'|trans({}, 'templates') }}
        </button>
        <button type="button" class="editor-filebar-btn editor-toggle-btn" data-editor-target="toggleButton" data-action="click->editor#toggleReadonly">
            {{ readonly
                ? 'templates.home.index.editor.toggle.edit'|trans({}, 'templates')
                : 'templates.home.index.editor.toggle.readonly'|trans({}, 'templates') }}
        </button>
    </div>
</div>
