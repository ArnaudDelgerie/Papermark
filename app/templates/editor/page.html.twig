{% extends 'base.html.twig' %}

{# Shell shared by both modes: it carries the mode selector and holds both left
   columns from the start. The inactive one is hidden, not absent, so it is
   already loaded when the user switches. #}
{% block body %}
{# editor-state is the master of the client state (EDITOR_REACTIVITY.md, S3-S4):
   it holds the store and makes every write. Children reach it by outlet. #}
<div class="editor-page" id="editor-state"
     data-controller="editor-state"
     data-editor-state-state-value="{{ state|json_encode }}"
     data-editor-state-urls-value="{{ {
         state: path('app_editor_get_state'),
         mode: path('app_editor_set_mode'),
         file: path('app_editor_set_file'),
         dir: path('app_editor_set_dir'),
         refreshDir: path('app_editor_refresh_dir'),
         save: path('app_document_save'),
         delete: path('app_document_delete'),
         rename: path('app_document_rename'),
         setKey: path('app_settings_set_key', {name: '__name__'}),
         deleteKey: path('app_settings_delete_key', {name: '__name__'}),
         import: path('app_archive_import'),
     }|json_encode }}"
     data-editor-state-token-value="{{ csrf_token('papermark_app') }}"
     data-editor-state-i18n-value="{{ { failed: 'components.editor.error.request_failed'|trans({}, 'components') }|json_encode }}">
    <aside class="editor-sidebar">
        {% include 'components/_mode_switch.html.twig' %}

        {# Single mode: nothing to fetch, the history comes from sessionStorage;
           the controller replaces its loader once it has read it. #}
        {{ component('mode-single', { active: mode == 'single' }) }}

        {# Dir mode: only the tree is behind a frame, and it loads eagerly even
           while hidden — the FrankenPHP server is dedicated, nothing to spare. #}
        {{ component('mode-dir', { active: mode == 'dir' }) }}
    </aside>
    {# No file here: the editor fetches the current one itself on connect. #}
    {{ component('editor', {
        height: '100%',
    }) }}
</div>
{% endblock %}
