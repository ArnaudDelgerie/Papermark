{% extends 'base.html.twig' %}

{% block body %}
<div class="page-settings">
    <div class="settings-header">
        <a href="{{ path('app_home') }}" class="settings-back">{{ 'components.settings.back'|trans({}, 'components') }}</a>
        <h1>{{ 'components.settings.title'|trans({}, 'components') }}</h1>
    </div>

    {{ form_start(form, {attr: {class: 'settings-form'}}) }}
        {{ form_errors(form) }}

        {% for name, provider in form.providers %}
        <fieldset class="settings-fieldset">
            <legend class="settings-provider{% if form.selected[name].vars.checked %} is-selected{% endif %}">
                {{ form_widget(form.selected[name]) }}
                {{ form_label(form.selected[name], null, {label_attr: {class: 'settings-provider-name'}}) }}
                {% if has_key[name] %}
                <span class="settings-provider-badge">{{ 'components.settings.key_set'|trans({}, 'components') }}</span>
                <button type="button" class="settings-delete-key-btn" title="{{ 'components.settings.delete_key'|trans({}, 'components') }}"
                        data-controller="settings" data-action="click->settings#deleteKey"
                        data-url="{{ path('app_settings_delete_key', {name: name}) }}"
                        data-settings-csrf-token-value="{{ delete_key_csrf_token }}"
                        data-settings-delete-label-value="{{ 'components.settings.delete_key'|trans({}, 'components') }}"
                        data-settings-confirm-message-value="{{ 'components.settings.delete_key_confirm_message'|trans({}, 'components') }}"
                        data-settings-confirm-question-value="{{ 'components.settings.delete_key_confirm_question'|trans({}, 'components') }}">
                    <span class="visually-hidden">{{ 'components.settings.delete_key'|trans({}, 'components') }}</span>
                </button>
                {% endif %}
            </legend>

            {{ form_row(provider.model) }}
            {{ form_row(provider.apiKey) }}
        </fieldset>
        {% endfor %}

        <fieldset class="settings-fieldset">
            <legend>{{ 'components.settings.mode_title'|trans({}, 'components') }}</legend>
            {% for radio in form.defaultMode %}
            <label class="settings-mode-option">
                {{ form_widget(radio) }}
                {{ form_label(radio) }}
            </label>
            {% endfor %}
        </fieldset>

        <fieldset class="settings-fieldset">
            <legend>{{ 'components.settings.theme_title'|trans({}, 'components') }}</legend>
            {% for radio in form.themeMode %}
            <label class="settings-mode-option">
                {{ form_widget(radio) }}
                {{ form_label(radio) }}
            </label>
            {% endfor %}
        </fieldset>

        <fieldset class="settings-fieldset" data-controller="settings"
                data-settings-update-available-value="{{ 'components.settings.update_available'|trans({}, 'components') }}"
                data-settings-up-to-date-value="{{ 'components.settings.up_to_date'|trans({}, 'components') }}"
                data-settings-update-check-failed-value="{{ 'components.editor.error.update_check_failed'|trans({}, 'components') }}"
                data-settings-update-check-unavailable-value="{{ 'components.settings.update_check_unavailable'|trans({}, 'components') }}">
            <legend>{{ 'components.settings.update_title'|trans({}, 'components') }}</legend>
            <button type="button" class="settings-submit settings-submit-secondary" data-action="click->settings#checkForUpdate">
                {{ 'components.settings.update_check_button'|trans({}, 'components') }}
            </button>
            <span class="settings-update-result" data-settings-target="updateResult"></span>
        </fieldset>

        <div class="settings-submit-row">
            {{ form_widget(form.save, {attr: {class: 'settings-submit'}}) }}
            {{ form_widget(form.saveAndClose, {attr: {class: 'settings-submit settings-submit-secondary'}}) }}
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
