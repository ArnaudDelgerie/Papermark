{% extends 'base.html.twig' %}

{% block body %}
<div class="page-settings" data-controller="settings">
    <div class="settings-header">
        <a href="{{ path('app_home') }}" class="settings-back">{{ 'components.settings.back'|trans({}, 'components') }}</a>
        <h1>{{ 'components.settings.title'|trans({}, 'components') }}</h1>
    </div>

    {{ form_start(form, {attr: {class: 'settings-form'}}) }}
        {{ form_errors(form) }}

        <fieldset class="settings-fieldset">
            <legend>{{ 'components.settings.image_folder.title'|trans({}, 'components') }}</legend>
            <div class="settings-image-folder-row">
                {{ form_widget(form.imageFolder, {attr: {'data-settings-target': 'imageFolderInput', placeholder: 'components.settings.image_folder.placeholder'|trans({}, 'components')}}) }}
                <button type="button" class="settings-choose-folder-btn" data-action="click->settings#pickImageFolder">
                    {{ 'components.settings.image_folder.choose'|trans({}, 'components') }}
                </button>
            </div>
            {{ form_errors(form.imageFolder) }}
        </fieldset>

        {% for name, provider in form.providers %}
        <fieldset class="settings-fieldset">
            <legend class="settings-provider{% if form.selected[name].vars.checked %} is-selected{% endif %}">
                {{ form_widget(form.selected[name]) }}
                {{ form_label(form.selected[name], null, {label_attr: {class: 'settings-provider-name'}}) }}
                {% if has_key[name] %}
                <span class="settings-provider-badge">{{ 'components.settings.key_set'|trans({}, 'components') }}</span>
                {% endif %}
            </legend>

            {{ form_row(provider.model) }}
            {{ form_row(provider.apiKey) }}
        </fieldset>
        {% endfor %}

        <button type="submit" class="settings-submit">
            {{ 'components.settings.save'|trans({}, 'components') }}
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
