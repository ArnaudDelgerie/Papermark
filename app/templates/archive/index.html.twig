{% extends 'base.html.twig' %}

{% block body %}
<div class="page-archive">
    <div class="archive-header">
        <a href="{{ path('app_home') }}" class="archive-back">{{ 'components.archive.back'|trans({}, 'components') }}</a>
        <h1>{{ 'components.archive.title'|trans({}, 'components') }}</h1>
    </div>

    <section class="archive-block"
         data-controller="export"
         data-export-initial-kind-value="{{ initial_kind }}"
         data-export-initial-path-value="{{ initial_path }}"
         data-export-initial-directory-value="{{ initial_directory }}"
         data-export-csrf-token-value="{{ export_csrf_token }}"
         data-export-run-url-value="{{ path('app_export_run') }}"
         data-export-i18n-value="{{ export_i18n|json_encode }}">
        <h2>{{ 'components.export.title'|trans({}, 'components') }}</h2>

        <fieldset class="export-fieldset">
            <legend>{{ 'components.export.source_title'|trans({}, 'components') }}</legend>

            <div class="export-kind">
                <label class="export-kind-option">
                    <input type="radio" name="export-kind" value="file" data-export-target="kindFileRadio" data-action="change->export#changeKind">
                    {{ 'components.export.source_file'|trans({}, 'components') }}
                </label>
                <label class="export-kind-option">
                    <input type="radio" name="export-kind" value="directory" data-export-target="kindDirectoryRadio" data-action="change->export#changeKind">
                    {{ 'components.export.source_folder'|trans({}, 'components') }}
                </label>
            </div>

            <div class="export-source-row">
                <span class="export-source-path" data-export-target="sourcePath"></span>
                <button type="button" class="export-browse-btn" data-action="click->export#browse">{{ 'components.export.browse'|trans({}, 'components') }}</button>
            </div>
        </fieldset>

        <label class="export-checkbox">
            <input type="checkbox" data-export-target="includeExternalMarkdown">
            {{ 'components.export.include_external_markdown'|trans({}, 'components') }}
        </label>

        <button type="button" class="export-submit" data-export-target="exportButton" data-action="click->export#run">
            {{ 'components.export.export_button'|trans({}, 'components') }}
        </button>

        <div class="export-report" data-export-target="report" hidden></div>
    </section>

    <section class="archive-block"
         data-controller="import"
         data-import-csrf-token-value="{{ import_csrf_token }}"
         data-import-run-url-value="{{ path('app_import_run') }}"
         data-import-home-url-value="{{ path('app_home') }}"
         data-import-i18n-value="{{ import_i18n|json_encode }}">
        <h2>{{ 'components.import.title'|trans({}, 'components') }}</h2>

        <fieldset class="export-fieldset">
            <legend>{{ 'components.import.archive_title'|trans({}, 'components') }}</legend>

            <div class="export-source-row">
                <span class="export-source-path" data-import-target="archivePath"></span>
                <button type="button" class="export-browse-btn" data-action="click->import#browseArchive">{{ 'components.import.browse'|trans({}, 'components') }}</button>
            </div>
        </fieldset>

        <fieldset class="export-fieldset">
            <legend>{{ 'components.import.parent_title'|trans({}, 'components') }}</legend>

            <div class="export-source-row">
                <span class="export-source-path" data-import-target="parentPath"></span>
                <button type="button" class="export-browse-btn" data-action="click->import#browseParent">{{ 'components.import.browse'|trans({}, 'components') }}</button>
            </div>
        </fieldset>

        <button type="button" class="export-submit" data-import-target="importButton" data-action="click->import#run">
            {{ 'components.import.import_button'|trans({}, 'components') }}
        </button>

        <div class="export-report" data-import-target="report" hidden></div>
    </section>
</div>
{% endblock %}
