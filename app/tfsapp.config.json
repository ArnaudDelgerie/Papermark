{
  "product_name": "Papermark",
  "identifier": "dev.local.papermark",
  "project_name": "papermark",
  "app_version": "0.1.2",
  "icon_path": "icon.png",
  "splash_path": "splash.html",
  "splash_bg": "#121212",
  "splash_text": "#e0e0e0",
  "workers": [
    {
      "transports": [
        "async"
      ]
    }
  ],
  "commands": {
    "pre-install": [
      "doctrine:migrations:migrate --no-interaction"
    ],
    "post-install": [
      "app:ai:seed-providers"
    ],
    "pre-update": [
      "doctrine:migrations:migrate --no-interaction"
    ],
    "post-update": [
      "app:ai:seed-providers"
    ]
  },
  "actions": {
    "secrets": {
      "ipc": false,
      "bridge": true,
      "keys": ["openai", "anthropic", "mistral"]
    },
    "update": {
      "ipc": true,
      "bridge": false
    },
    "close_guard": {
      "ipc": true,
      "bridge": true
    },
    "picker": {
      "ipc": true
    },
    "open_files": {
      "ipc": true,
      "directories": true
    }
  },
  "file_associations": {
    "mime_types": ["text/markdown", "inode/directory"]
  }
}